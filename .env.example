# =============================================================================
# Google Service Account (required)
# Used server-side to read the weekly registration spreadsheets from Google
# Sheets / Drive. Create a service account in Google Cloud, enable the Sheets
# and Drive APIs, and share the spreadsheets with the service account email.
# See src/lib/sheets.ts
# =============================================================================

# Service account client email, e.g. my-app@my-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# Service account private key from the downloaded JSON key file.
# Keep the surrounding quotes and the literal \n escapes (they are converted to
# real newlines at runtime). e.g. "-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
GOOGLE_PRIVATE_KEY=

# =============================================================================
# Public app configuration (exposed to the browser — no secrets here)
# =============================================================================

# Base URL of the app, used for absolute links/metadata. Defaults to
# http://localhost:3000 in development.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Facebook Messenger contact link shown in the contact bar. Defaults to "#".
NEXT_PUBLIC_CONTACT_MESSENGER_URL=

# Instagram contact link shown in the contact bar. Defaults to "#".
NEXT_PUBLIC_CONTACT_INSTAGRAM_URL=

# =============================================================================
# Cache clearing (optional, server-only — NOT exposed to the browser)
# Secret required to clear the shared Google Sheets cache via
# POST /api/cache/clear. The app reveals a hidden "Clear cache" button when the
# page is opened with ?clearKey=<this value>. Leave blank to disable the button.
# Use a long random string, e.g. `openssl rand -hex 16`.
# =============================================================================
CACHE_CLEAR_SECRET=

# Google Apps Script registration notifications. Set the same long random value
# as DVC_WEBHOOK_SECRET in Apps Script's Script Properties. Server-only.
# The script calls POST /api/registrations/updated using x-registration-key.
REGISTRATION_WEBHOOK_SECRET=

# Database-backed club app. Server-only; never prefix these with NEXT_PUBLIC_.
# Keep false until a new week is ready to cut over. Preview is always at /club.
DVC_APP_ENABLED=false
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Generate locally: openssl rand -hex 32. Keep stable across deployments.
DVC_SESSION_SECRET=
DVC_ORGANIZATION_ID=00000000-0000-0000-0000-000000000001
# Developer access uses the protected Developer role in staff_email_whitelist.
